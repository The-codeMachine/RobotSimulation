{
    "version": 6,

    "cmakeMinimumRequired": {
        "major": 3,
        "minor": 23,
        "patch": 0
    },

    "configurePresets": [
        {
            "name": "windows-vs2022-debug",
            "displayName": "Windows / MSVC 2022 / Debug",
            "generator": "Visual Studio 17 2022",
            "architecture": "x64",
            "binaryDir": "${sourceDir}/build/windows-vs2022-debug"
        },

        {
            "name": "windows-vs2022-release",
            "displayName": "Windows / MSVC 2022 / Release",
            "generator": "Visual Studio 17 2022",
            "architecture": "x64",
            "binaryDir": "${sourceDir}/build/windows-vs2022-release"
        },

        {
            "name": "windows-vs2026-debug",
            "displayName": "Windows / MSVC 2026 / Debug",
            "generator": "Visual Studio 18 2026",
            "architecture": "x64",
            "binaryDir": "${sourceDir}/build/windows-vs2026-debug"
        },

        {
            "name": "windows-vs2026-release",
            "displayName": "Windows / MSVC 2026 / Release",
            "generator": "Visual Studio 18 2026",
            "architecture": "x64",
            "binaryDir": "${sourceDir}/build/windows-vs2026-release"
        },

        {
            "name": "linux-gcc-debug",
            "displayName": "Linux / GCC / Debug",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/linux-gcc-debug",
            "cacheVariables": {
                "CMAKE_C_COMPILER": "gcc",
                "CMAKE_CXX_COMPILER": "g++",
                "CMAKE_BUILD_TYPE": "Debug"
            }
        },

        {
